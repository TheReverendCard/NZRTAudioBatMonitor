diff --git a/BatDailyTool/test_rt_batch.py b/BatDailyTool/test_rt_batch.py
new file mode 100644
--- /dev/null
+++ b/BatDailyTool/test_rt_batch.py
@@ -0,0 +1,106 @@
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from daily_state import State
+from review_first_daily import import_receiver
+import rt_day_pack
+import rt_logs
+
+
+class RTBatchTests(unittest.TestCase):
+    def setUp(self):
+        folder = tempfile.TemporaryDirectory()
+        self.addCleanup(folder.cleanup)
+        self.root = Path(folder.name).resolve()
+        self.state = State(self.root)
+        self.addCleanup(self.state.db.close)
+        self.device = self.root / "WiFi_Backup" / "RT" / "device"
+        self.device.mkdir(parents=True)
+
+    def add(self, name, data):
+        path = self.device / name
+        path.write_bytes(data)
+        self.state.put("rtlogs-file", path.relative_to(self.root).as_posix())
+        return path
+
+    def run_import(self):
+        import_receiver(self.state, "rtlogs")
+        value = self.state.db.execute("SELECT value FROM notes WHERE key='rt-import-latest'").fetchone()
+        return json.loads(value[0])
+
+    def test_date_batch_and_exact_reuse(self):
+        for day in ("20261121", "20261122", "20261123"):
+            (self.root / day).mkdir()
+        data = b"NZRT CANDIDATE seq=1\r\n"
+        self.add("1795300000_1.txt", data)
+        self.add("1795300001_2.txt", data)
+        self.add("1795300002_3.txt", data.replace(b"=1", b"=2"))
+        self.add("1795300003_4.txt", b"unrelated")
+        self.add("badname.txt", data)
+        report = self.run_import()
+        self.assertEqual([report[k] for k in ("new", "reused", "non_nzrt", "other_queue_entries")], [2, 1, 1, 1])
+        self.assertFalse(self.state.pending("rtlogs-file"))
+        self.assertEqual(len(self.state.pending("timeline-day")), 3)
+        day, = self.state.pending("rt-pack-day")
+        receipt = self.root / "Daily_Run_Reports" / day / "XiaoRT" / "collection.json"
+        self.assertEqual(len(json.loads(receipt.read_text())["archived_logs"]), 2)
+        self.add("1795300004_5.txt", b"NZRT FIELD\n")
+        self.run_import()
+        self.assertEqual(len(json.loads(receipt.read_text())["archived_logs"]), 3)
+
+    def test_damaged_raw_and_usb_method(self):
+        data = b"NZRT FIELD\n"
+        path = self.add("1795300000_1.txt", data)
+        usb, _ = rt_logs.archive_log(self.root, data, "serial", False)
