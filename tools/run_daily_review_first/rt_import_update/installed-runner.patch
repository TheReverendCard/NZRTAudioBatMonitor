diff --git a/BatDailyTool/rt_daily_batch.py b/BatDailyTool/rt_daily_batch.py
new file mode 100644
--- /dev/null
+++ b/BatDailyTool/rt_daily_batch.py
@@ -0,0 +1,117 @@
+"""Batch the pending RT receiver text uploads from the review-first daily queue."""
+
+import json
+import time
+from collections import Counter, defaultdict
+from datetime import timedelta
+from zoneinfo import ZoneInfo
+
+import rt_logs
+
+
+def import_pending(state, resolve_path, receiver_signature):
+    root = state.root
+    task = "rtlogs-file"
+    pending = state.pending(task)
+    groups = defaultdict(list)
+    ignored = []
+    zone = ZoneInfo("Pacific/Auckland")
+    started = time.perf_counter()
+    for rel in pending:
+        path = resolve_path(root, rel)
+        stamp = rt_logs.backup_timestamp(path)
+        if stamp is None or path.suffix.lower() != ".txt" or not path.is_file():
+            ignored.append(rel)
+            continue
+        groups[stamp.astimezone(zone).date()].append((rel, path))
+
+    def checkpoint(rels):
+        state.db.executemany("DELETE FROM jobs WHERE stage=? AND item=?",
+                             ((task, rel) for rel in rels))
+        state.db.commit()
+
+    checkpoint(ignored)
+    total = sum(map(len, groups.values()))
+    if not total:
+        print(f"XiaoRT: no timestamped text uploads in {len(pending)} queue entries.", flush=True)
+        return
+    print(f"XiaoRT: {total} uploads across {len(groups)} NZ dates. Reading archive receipts once.", flush=True)
+    index_start = time.perf_counter()
+    index = rt_logs.ReceiptIndex(root, state.db)
+    indexed = time.perf_counter()
+    print(f"XiaoRT: indexed {index.count} receipts ({index.cached} cached) in {indexed-index_start:.2f}s.", flush=True)
+    counts = Counter()
+    processed = 0
+    last_progress = indexed
+    for date, rows in sorted(groups.items()):
+        day = date.strftime("%Y%m%d")
+        paths = []
+        errors = []
+        day_counts = Counter()
+        for rel, path in sorted(rows):
+            signature = receiver_signature(path)
+            if state.blocked(rel, signature):
+                day_counts["quarantined"] += 1
+            else:
+                try:
+                    with path.open("rb") as stream:
+                        sample = stream.read(8192)
+                        data = sample + stream.read() if b"NZRT " in sample else None
+                except OSError as exc:
+                    state.reject(rel, signature, exc)
+                    day_counts["read_errors"] += 1
+                    errors.append(f"{rel}: {exc}")
+                else:
+                    if receiver_signature(path) != signature:
+                        raise RuntimeError(f"Receiver upload changed during import. Retry {rel}")
+                    if data is None:
+                        day_counts["non_nzrt"] += 1
+                    else:
+                        before = index.created
+                        archive, meta = rt_logs.import_log_bytes(root, path, data, index)
+                        day_counts["new" if index.created > before else "reused"] += 1
+                        paths.append(archive.relative_to(root).as_posix())
+                        day_counts["source_bytes"] += len(data)
+            processed += 1
+            now = time.perf_counter()
+            if now - last_progress >= 10:
+                print(f"XiaoRT: {processed}/{total} uploads checked in {now-started:.1f}s.", flush=True)
+                last_progress = now
+        receipt = root / "Daily_Run_Reports" / day / "XiaoRT" / "collection.json"
+        prior = rt_logs.read_json(receipt, {})
+        if paths:
+            history = list(prior.get("archived_logs", []))
+            if prior.get("raw_log"):
+                history.append(prior["raw_log"])
+            archives = list(dict.fromkeys(history + paths))
+            rt_logs.collection_status(root, day, "wifi_imported", raw_log=paths[-1],
+                                      sha256=meta["sha256"], complete=bool(meta["complete"]),
+                                      files_imported=len(archives), archived_logs=archives,
+                                      skipped_files=day_counts["non_nzrt"], errors=errors,
+                                      batch=dict(day_counts))
+            for offset in (-1, 0, 1):
+                target = (date + timedelta(days=offset)).strftime("%Y%m%d")
+                if (root / target).is_dir():
+                    state.put("timeline-day", target)
+                    state.put("final", "timelines")
+        elif prior.get("status") not in {"wifi_imported", "imported", "downloaded"}:
+            rt_logs.collection_status(root, day, "not_collected", searched_files=len(rows),
+                                      skipped_files=day_counts["non_nzrt"], errors=errors,
+                                      batch=dict(day_counts))
+        state.put("rt-pack-day", day)
+        # Publish the receipt and downstream work before clearing this date's jobs.
+        checkpoint(rel for rel, _ in rows)
+        counts.update(day_counts)
+    elapsed = time.perf_counter() - started
+    print(f"XiaoRT: {processed} checked, {counts['new']} newly archived, "
+          f"{counts['reused']} verified duplicates, {counts['non_nzrt']} non-NZRT, "
+          f"{counts['read_errors']} read errors, {counts['quarantined']} already quarantined, "
+          f"{elapsed:.2f}s.", flush=True)
+    detail = dict(counts)
+    detail.update(checked=processed, other_queue_entries=len(ignored), receipts_indexed=index.count,
+                  cached_receipts=index.cached, invalid_receipts=index.invalid,
+                  index_seconds=round(indexed-index_start, 3),
+                  total_seconds=round(elapsed, 3), run=state.run)
+    state.db.execute("INSERT OR REPLACE INTO notes VALUES (?,?)",
+                     ("rt-import-latest", json.dumps(detail, sort_keys=True)))
+    state.db.commit()
diff --git a/BatDailyTool/rt_day_pack.py b/BatDailyTool/rt_day_pack.py
new file mode 100644
--- /dev/null
+++ b/BatDailyTool/rt_day_pack.py
@@ -0,0 +1,110 @@
+"""Lossless per-device, NZ upload-date logs with a readable first-occurrence view."""
+import argparse
+from collections import defaultdict
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import tempfile
+import zipfile
+from zoneinfo import ZoneInfo
+
+from rt_logs import backup_timestamp
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def restore(lines, row):
+    crlf = set(row.get("crlf", []))
+    last = len(row["lines"]) - 1
+    data = b"".join(lines[n - 1] + (b"" if i == last and row.get("unterminated")
+                                    else b"\r\n" if i in crlf else b"\n")
+                    for i, n in enumerate(row["lines"]))
+    if len(data) != row["bytes"] or sha(data) != row["sha256"]:
+        raise ValueError("Upload reconstruction failed: " + row["file"])
+    return data
+
+
+def read_pack(path):
+    with zipfile.ZipFile(path) as bundle:
+        lines = bundle.read("daily.log").split(b"\n")[:-1]
+        rows = [json.loads(s) for s in bundle.read("uploads.jsonl").splitlines()]
+    return {row["file"]: restore(lines, row) for row in rows}
+
+
+def build(path, sources, device, day):
+    # Receiver retention can remove an old source after the first publication.
+    stored = read_pack(path) if path.is_file() else {}
+    payloads = dict(stored)
+    for src in sources:
+        data = src.read_bytes()
+        if src.name in stored and stored[src.name] != data:
+            raise ValueError(f"Receiver bytes conflict with the saved daily pack: {src}")
+        payloads[src.name] = data
+    if payloads == stored:
+        return
+    numbers, rows = {}, []
+    for name, data in sorted(payloads.items()):
+        row = {"file": name, "bytes": len(data), "sha256": sha(data), "lines": []}
+        for i, raw in enumerate(io.BytesIO(data)):
+            if raw.endswith(b"\r\n"):
+                line = raw[:-2]
+                row.setdefault("crlf", []).append(i)
+            elif raw.endswith(b"\n"):
+                line = raw[:-1]
+            else:
+                line = raw
+                row["unterminated"] = True
+            row["lines"].append(numbers.setdefault(line, len(numbers) + 1))
+        rows.append(row)
+    summary = dict(device=device, nz_receiver_date=day, files=len(rows),
+                   input_bytes=sum(r["bytes"] for r in rows),
+                   line_occurrences=sum(len(r["lines"]) for r in rows),
+                   distinct_lines=len(numbers), format_version=1)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name, suffix=".tmp")
+    os.close(fd)
+    try:
+        with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED, compresslevel=6) as bundle:
+            bundle.writestr("daily.log", b"".join(line + b"\n" for line in numbers))
+            bundle.writestr("uploads.jsonl", "\n".join(json.dumps(r, separators=(",", ":")) for r in rows) + "\n")
+            bundle.writestr("summary.json", json.dumps(summary, indent=2))
+        if read_pack(tmp) != payloads:
+            raise ValueError("Daily pack differs from source uploads: " + str(path))
+        os.replace(tmp, path)
+    finally:
+        Path(tmp).unlink(missing_ok=True)
+    print(f"XiaoRT {day} {device}: {len(rows)} uploads, {summary['line_occurrences']} lines, "
+          f"{len(numbers)} distinct. Verified daily log: {path}", flush=True)
+
+
+def pack_days(root, days, output=None):
+    receiver = root / "WiFi_Backup" / "RT"
+    if not receiver.is_dir():
+        return
+    groups = defaultdict(list)
+    zone = ZoneInfo("Pacific/Auckland")
+    for device in receiver.iterdir():
+        if not device.is_dir() or device.resolve() != device:
+            continue
+        for item in device.glob("*.txt"):
+            stamp = backup_timestamp(item)
+            if stamp:
+                day = stamp.astimezone(zone).strftime("%Y%m%d")
+                if (days is None or day in days) and item.resolve() == item and item.is_file():
+                    groups[device.name, day].append(item)
+    output = output or root / "Daily_Run_Reports" / "RT_Daily_Logs"
+    for (device, day), sources in sorted(groups.items()):
+        build(output / device / (day + ".zip"), sources, device, day)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
+    parser.add_argument("--day", action="append", help="NZ receiver date YYYYMMDD. Omit for all dates.")
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    pack_days(args.root.resolve(), set(args.day) if args.day else None, args.output)
