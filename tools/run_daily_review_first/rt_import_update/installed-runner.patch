+++ b/BatDailyTool/replay_benchmark.py
@@ -0,0 +1,66 @@
+"""Replay one completed intake on a private copy of the pre-existing archive."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+import time
+
+
+def replay(live, prefix):
+    sys.path.append(str(live / "BatDailyTool"))
+    from daily_state import State
+    from review_first_daily import import_receiver
+
+    raw = live / "XiaoRT_Logs" / "Raw"
+    originals = {p.name: p for p in (live / "WiFi_Backup" / "RT").glob("*/*.txt")}
+    with tempfile.TemporaryDirectory(prefix="bat-rt-replay-") as tmp:
+        root = Path(tmp).resolve()
+        archive = root / "XiaoRT_Logs" / "Raw"
+        archive.mkdir(parents=True)
+        incoming = {}
+        for receipt in raw.glob("*.json"):
+            if receipt.name.startswith(prefix):
+                meta = json.loads(receipt.read_text(encoding="utf-8-sig"))
+                src = originals[meta["original_filename"]]
+                dest = root / src.relative_to(live)
+                dest.parent.mkdir(parents=True, exist_ok=True)
+                shutil.copyfile(src, dest)
+                assert hashlib.sha256(dest.read_bytes()).hexdigest() == meta["sha256"]
+                incoming[dest.relative_to(root).as_posix()] = meta["sha256"]
+            elif receipt.name < prefix:
+                shutil.copyfile(receipt, archive / receipt.name)
+                text = receipt.with_suffix(".txt")
+                if text.is_file():
+                    shutil.copyfile(text, archive / text.name)
+        assert incoming
+        state = State(root)
+        try:
+            for label in ("new", "reused"):
+                for rel in incoming:
+                    state.put("rtlogs-file", rel)
+                state.db.commit()
+                start = time.perf_counter()
+                import_receiver(state, "rtlogs")
+                wall = time.perf_counter() - start
+                stats = json.loads(state.db.execute(
+                    "SELECT value FROM notes WHERE key='rt-import-latest'").fetchone()[0])
+                assert stats[label] == len(incoming) and not state.pending("rtlogs-file"), stats
+                archived = set()
+                for f in (root / "Daily_Run_Reports").glob("*/XiaoRT/collection.json"):
+                    for rel in json.loads(f.read_text())["archived_logs"]:
+                        archived.add(hashlib.sha256((root / rel).read_bytes()).hexdigest())
+                assert archived == set(incoming.values())
+                print(label, "wall seconds", round(wall, 3), stats, flush=True)
+        finally:
+            state.db.close()
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("root", type=Path)
+    parser.add_argument("capture_prefix")
+    args = parser.parse_args()
+    replay(args.root.resolve(), args.capture_prefix)
